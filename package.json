{
  "name": "comic-manage",
  "productName": "Comic Manage",
  "version": "1.8.0",
  "private": true,
  "description": "本地漫画资料管理与无损 CBZ 整理",
  "author": "Jesse0810",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/desktop-dev.cjs",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "build": "npm run typecheck && vite build && node scripts/copy-licenses.cjs",
    "start": "electron .",
    "test:bridge": "node --test electron/tests/*.test.cjs",
    "test:core": "node scripts/test-core.cjs",
    "test:desktop": "node scripts/test-desktop.cjs",
    "build:service": "node scripts/build-service.cjs",
    "dist:win": "npm run build && npm run build:service && electron-builder --win zip --x64",
    "pack:win": "npm run build && npm run build:service && electron-builder --win --dir --x64"
  },
  "dependencies": {
    "vue": "3.5.44",
    "element-plus": "2.14.7",
    "@element-plus/icons-vue": "2.3.2"
  },
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "@vitejs/plugin-vue": "6.0.10",
    "vite": "8.3.5",
    "typescript": "5.9.3",
    "vue-tsc": "3.3.14",
    "@types/node": "24.10.1"
  },
  "build": {
    "appId": "com.jesse.comicmanage",
    "productName": "ComicManage",
    "asar": true,
    "electronDist": "node_modules/electron/dist",
    "directories": { "output": "release" },
    "files": ["electron/**/*.cjs", "!electron/tests/**/*", "!electron/smoke.cjs", "renderer-dist/**/*", "package.json"],
    "extraResources": [
      { "from": "build/service/ComicManageService", "to": "service" },
      { "from": "README.md", "to": "README.md" },
      { "from": "THIRD_PARTY_NOTICES.md", "to": "THIRD_PARTY_NOTICES.md" },
      { "from": "build/frontend-licenses", "to": "licenses/frontend" },
      { "from": "scripts/sync-komga.ps1", "to": "scripts/sync-komga.ps1" },
      { "from": "docs/NAS_METADATA.md", "to": "KOMGA_METADATA.md" }
    ],
    "win": { "target": ["zip"], "signAndEditExecutable": false },
    "artifactName": "ComicManage-Electron-${version}-windows-${arch}.${ext}"
  }
}
